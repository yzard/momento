ARG RUST_IMAGE=rust:1-bookworm
ARG CUDA_IMAGE=nvidia/cuda:12.9.1-cudnn-runtime-ubuntu22.04
ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.8.22

ARG VLLM_VERSION=0.27.1
ARG VLLM_CUDA_VERSION=129
ARG OCR_PYTHON_VERSION=3.12.11
ARG TORCH_VERSION=2.7.0
ARG TORCHVISION_VERSION=0.22.0
ARG TRANSFORMERS_RAM_VERSION=4.30.2
ARG TRANSFORMERS_DINOV2_VERSION=4.46.3
ARG HUGGINGFACE_HUB_RAM_VERSION=0.24.7
ARG TIMM_VERSION=0.4.12
ARG FAIRSCALE_VERSION=0.4.4
ARG NUMPY_VERSION=1.26.4
ARG SCIPY_VERSION=1.15.3
ARG PILLOW_VERSION=11.2.1
ARG CYTHON_VERSION=3.1.2
ARG INSIGHTFACE_VERSION=0.7.3
ARG ONNXRUNTIME_GPU_VERSION=1.22.0

ARG CLIP_COMMIT=d05afc436d78f1c48dc0dbf8e5980a9d471f35f6
ARG RAM_COMMIT=7cb804a8609e9f4b1a50b7f31436d2df40bb9481
ARG UNLIMITED_OCR_REVISION=07dea832e22aefee32ad281d4b80551282e1c168
ARG DINOV2_REVISION=ed25f3a31f01632728cabb09d1542f84ab7b0056
ARG RAM_CHECKPOINT_REVISION=84d4aee3a0265c4e0df1f714f0572011d1bf2ec3
ARG BERT_TOKENIZER_REVISION=86b5e0934494bd15c9632b12f734a8a67f723594
ARG BUFFALO_L_RELEASE=v0.7
ARG AESTHETIC_PREDICTOR_REVISION=6d122adad522ab246644d9dc1c6d7a3810ee255f
ARG RAM_CHECKPOINT_SHA256=497c178836ba66698ca226c7895317e6e800034be986452dbd2593298d50e87d
ARG BUFFALO_L_SHA256=80ffe37d8a5940d59a7384c201a2a38d4741f2f3c51eef46ebb28218a7b0ca2f
ARG CLIP_VIT_B_32_SHA256=40d365715913c9da98579312b702a82c18be219cc2a73407c4526f58eba950af
ARG AESTHETIC_HEAD_SHA256=c7b14cead230694acc7b9447974d3cad78003c72da032e402a303b6c2429e85f

FROM ${RUST_IMAGE} AS rust-builder

WORKDIR /app

COPY src/backend_llm ./src/backend_llm
COPY src/common ./src/common

RUN CARGO_TARGET_DIR=/app/build/target cargo build --release --locked --manifest-path /app/src/backend_llm/Cargo.toml

FROM ${UV_IMAGE} AS uv

FROM ${CUDA_IMAGE} AS runtime-base

ENV DEBIAN_FRONTEND=noninteractive \
    HF_HOME=/opt/models/huggingface \
    HF_HUB_DISABLE_TELEMETRY=1 \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    RUST_BACKTRACE=full \
    UV_NO_CACHE=1 \
    UV_PYTHON_INSTALL_DIR=/opt/python \
    XDG_CACHE_HOME=/data/cache

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    gosu \
    libgl1 \
    libglib2.0-0 \
    libgomp1 \
    python3 \
    python3-venv \
    tini \
    tzdata \
    && rm -rf /var/lib/apt/lists/*

FROM runtime-base AS build-tools

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    git \
    python3-dev \
    unzip \
    && rm -rf /var/lib/apt/lists/*

COPY --from=uv /uv /usr/local/bin/uv

FROM build-tools AS ocr-builder

ARG VLLM_VERSION
ARG VLLM_CUDA_VERSION
ARG OCR_PYTHON_VERSION

RUN uv python install "${OCR_PYTHON_VERSION}" \
    && uv venv --python "${OCR_PYTHON_VERSION}" /opt/venvs/ocr

RUN uv pip install --python /opt/venvs/ocr/bin/python \
    --extra-index-url "https://download.pytorch.org/whl/cu${VLLM_CUDA_VERSION}" \
    --index-strategy unsafe-best-match \
    "https://github.com/vllm-project/vllm/releases/download/v${VLLM_VERSION}/vllm-${VLLM_VERSION}+cu${VLLM_CUDA_VERSION}-cp38-abi3-manylinux_2_28_x86_64.whl" \
    && uv pip check --python /opt/venvs/ocr/bin/python \
    && /opt/venvs/ocr/bin/python -c "import sys, torch, vllm; from pathlib import Path; assert sys.version_info[:2] == (3, 12); assert torch.version.cuda == '12.9'; assert Path(sys._base_executable).is_relative_to('/opt/python'); assert vllm.__version__ == '${VLLM_VERSION}'"

# The complete OCR environment is larger than GHCR's layer limit. The final image copies
# its CUDA Python packages and the remainder from separate build-stage snapshots.
FROM ocr-builder AS ocr-without-nvidia

RUN rm -rf /opt/venvs/ocr/lib/python3.12/site-packages/nvidia

FROM ocr-builder AS triton-launcher-builder

# Triton's launcher is a host Python extension whose cache key depends on its source and
# platform. Link it against NVIDIA's development stub; the real driver satisfies the same
# libcuda.so.1 dependency when the final container starts with GPU access.
RUN apt-get update && apt-get install -y --no-install-recommends cuda-driver-dev-12-9 \
    && rm -rf /var/lib/apt/lists/* \
    && ln -s libcuda.so /usr/local/cuda-12.9/targets/x86_64-linux/lib/stubs/libcuda.so.1 \
    && LD_LIBRARY_PATH=/usr/local/cuda-12.9/targets/x86_64-linux/lib/stubs \
       TRITON_LIBCUDA_PATH=/usr/local/cuda-12.9/targets/x86_64-linux/lib/stubs \
       TRITON_CACHE_DIR=/opt/triton-cache \
       /opt/venvs/ocr/bin/python -c "from triton.backends.nvidia.driver import CudaUtils; CudaUtils()"

FROM build-tools AS python-builder

ARG TORCH_VERSION
ARG TORCHVISION_VERSION
ARG TRANSFORMERS_RAM_VERSION
ARG TRANSFORMERS_DINOV2_VERSION
ARG HUGGINGFACE_HUB_RAM_VERSION
ARG TIMM_VERSION
ARG FAIRSCALE_VERSION
ARG NUMPY_VERSION
ARG SCIPY_VERSION
ARG PILLOW_VERSION
ARG CYTHON_VERSION
ARG INSIGHTFACE_VERSION
ARG ONNXRUNTIME_GPU_VERSION
ARG CLIP_COMMIT
ARG RAM_COMMIT

# RAM and DINOv2 use the same CUDA Torch build. Installing it into the shared system site
# packages keeps one copy while each venv retains its required Transformers version.
RUN uv pip install --system --python /usr/bin/python3 \
    --index-url https://download.pytorch.org/whl/cu128 \
    "torch==${TORCH_VERSION}" "torchvision==${TORCHVISION_VERSION}"

RUN uv venv --python /usr/bin/python3 --system-site-packages /opt/venvs/ram \
    && uv venv --python /usr/bin/python3 --system-site-packages /opt/venvs/dinov2 \
    && uv venv --python /usr/bin/python3 /opt/venvs/insightface

RUN uv pip install --python /opt/venvs/ram/bin/python \
    "transformers==${TRANSFORMERS_RAM_VERSION}" \
    "huggingface_hub==${HUGGINGFACE_HUB_RAM_VERSION}" \
    "numpy==${NUMPY_VERSION}" \
    "scipy==${SCIPY_VERSION}" \
    "Pillow==${PILLOW_VERSION}" \
    ftfy \
    packaging \
    regex \
    tqdm \
    && uv pip install --python /opt/venvs/ram/bin/python --no-deps \
    "timm==${TIMM_VERSION}" \
    "fairscale==${FAIRSCALE_VERSION}" \
    "git+https://github.com/openai/CLIP.git@${CLIP_COMMIT}" \
    "git+https://github.com/xinyu1205/recognize-anything.git@${RAM_COMMIT}"

RUN uv pip install --python /opt/venvs/dinov2/bin/python \
    "transformers==${TRANSFORMERS_DINOV2_VERSION}" \
    "Pillow==${PILLOW_VERSION}" \
    ftfy \
    packaging \
    regex \
    tqdm \
    && uv pip install --python /opt/venvs/dinov2/bin/python --no-deps \
    "git+https://github.com/openai/CLIP.git@${CLIP_COMMIT}"

RUN uv pip install --python /opt/venvs/insightface/bin/python \
    "numpy==${NUMPY_VERSION}" \
    "Cython==${CYTHON_VERSION}" \
    "insightface==${INSIGHTFACE_VERSION}" \
    "onnxruntime-gpu==${ONNXRUNTIME_GPU_VERSION}" \
    "Pillow==${PILLOW_VERSION}"

RUN uv pip check --system --python /usr/bin/python3 \
    && uv pip check --python /opt/venvs/insightface/bin/python \
    && /opt/venvs/ram/bin/python -c "import clip, fairscale, ram, timm, torch, torchvision, transformers; assert torch.__version__.startswith('${TORCH_VERSION}'); assert torchvision.__version__.startswith('${TORCHVISION_VERSION}'); assert transformers.__version__ == '${TRANSFORMERS_RAM_VERSION}'; assert torch.__file__.startswith('/usr/local/lib/python3.10/dist-packages/')" \
    && /opt/venvs/dinov2/bin/python -c "import clip, torch, torchvision, transformers; assert torch.__version__.startswith('${TORCH_VERSION}'); assert torchvision.__version__.startswith('${TORCHVISION_VERSION}'); assert transformers.__version__ == '${TRANSFORMERS_DINOV2_VERSION}'; assert torch.__file__.startswith('/usr/local/lib/python3.10/dist-packages/'); assert 'ViT-B/32' in clip.available_models()" \
    && /opt/venvs/insightface/bin/python -c "import insightface, onnxruntime"

FROM ocr-builder AS unlimited-ocr-model

ARG UNLIMITED_OCR_REVISION

RUN HF_HUB_OFFLINE=0 TRANSFORMERS_OFFLINE=0 /opt/venvs/ocr/bin/python -c \
    "from huggingface_hub import snapshot_download; snapshot_download('baidu/Unlimited-OCR', revision='${UNLIMITED_OCR_REVISION}', local_dir='/opt/models/unlimited-ocr')" \
    && rm -rf /opt/models/unlimited-ocr/.cache

FROM python-builder AS dinov2-model

ARG DINOV2_REVISION

RUN HF_HUB_OFFLINE=0 TRANSFORMERS_OFFLINE=0 /opt/venvs/dinov2/bin/python -c \
    "from huggingface_hub import snapshot_download; snapshot_download('facebook/dinov2-small', revision='${DINOV2_REVISION}', local_dir='/opt/models/dinov2-small', allow_patterns=['config.json', 'model.safetensors', 'preprocessor_config.json'])" \
    && rm -rf /opt/models/dinov2-small/.cache

FROM python-builder AS bert-tokenizer-model

ARG BERT_TOKENIZER_REVISION

RUN HF_HUB_OFFLINE=0 TRANSFORMERS_OFFLINE=0 /opt/venvs/ram/bin/python -c \
    "from huggingface_hub import snapshot_download; snapshot_download('bert-base-uncased', revision='${BERT_TOKENIZER_REVISION}', cache_dir='/opt/models/huggingface/hub', allow_patterns=['config.json', 'special_tokens_map.json', 'tokenizer.json', 'tokenizer_config.json', 'vocab.txt'])" \
    && mkdir -p /opt/models/huggingface/hub/models--bert-base-uncased/refs \
    && printf '%s' "${BERT_TOKENIZER_REVISION}" > /opt/models/huggingface/hub/models--bert-base-uncased/refs/main

FROM build-tools AS ram-model

ARG RAM_CHECKPOINT_REVISION
ARG RAM_CHECKPOINT_SHA256

RUN mkdir -p /opt/models/ram \
    && curl --fail --location --retry 3 \
    "https://huggingface.co/xinyu1205/recognize-anything-plus-model/resolve/${RAM_CHECKPOINT_REVISION}/ram_plus_swin_large_14m.pth" \
    --output /opt/models/ram/ram_plus_swin_large_14m.pth \
    && echo "${RAM_CHECKPOINT_SHA256}  /opt/models/ram/ram_plus_swin_large_14m.pth" | sha256sum --check -

FROM build-tools AS insightface-model

ARG BUFFALO_L_RELEASE
ARG BUFFALO_L_SHA256

RUN mkdir -p /opt/models/insightface/models/buffalo_l \
    && curl --fail --location --retry 3 \
    "https://github.com/deepinsight/insightface/releases/download/${BUFFALO_L_RELEASE}/buffalo_l.zip" \
    --output /tmp/buffalo_l.zip \
    && echo "${BUFFALO_L_SHA256}  /tmp/buffalo_l.zip" | sha256sum --check - \
    && unzip /tmp/buffalo_l.zip -d /opt/models/insightface/models/buffalo_l \
    && rm /tmp/buffalo_l.zip

FROM build-tools AS image-aesthetics-model

ARG AESTHETIC_PREDICTOR_REVISION
ARG CLIP_VIT_B_32_SHA256
ARG AESTHETIC_HEAD_SHA256

RUN mkdir -p /opt/models/clip /opt/models/aesthetic \
    && curl --fail --location --retry 3 \
    "https://openaipublic.azureedge.net/clip/models/${CLIP_VIT_B_32_SHA256}/ViT-B-32.pt" \
    --output /opt/models/clip/ViT-B-32.pt \
    && echo "${CLIP_VIT_B_32_SHA256}  /opt/models/clip/ViT-B-32.pt" | sha256sum --check - \
    && curl --fail --location --retry 3 \
    "https://raw.githubusercontent.com/LAION-AI/aesthetic-predictor/${AESTHETIC_PREDICTOR_REVISION}/sa_0_4_vit_b_32_linear.pth" \
    --output /opt/models/aesthetic/sa_0_4_vit_b_32_linear.pth \
    && echo "${AESTHETIC_HEAD_SHA256}  /opt/models/aesthetic/sa_0_4_vit_b_32_linear.pth" | sha256sum --check -

FROM runtime-base

ARG SOURCE_REPOSITORY=https://github.com/yzard/momento
ARG TRANSFORMERS_RAM_VERSION
ARG TRANSFORMERS_DINOV2_VERSION

LABEL org.opencontainers.image.source="${SOURCE_REPOSITORY}" \
      org.opencontainers.image.description="Momento managed local AI inference service"

ENV NO_ALBUMENTATIONS_UPDATE=1 \
    TRITON_CACHE_DIR=/data/llm/cache/triton \
    XDG_CACHE_HOME=/data/llm/cache

# Keep every copied artifact in an independently reusable, GHCR-safe layer.
COPY --from=ocr-builder /opt/python /opt/python
COPY --from=ocr-without-nvidia /opt/venvs/ocr /opt/venvs/ocr
COPY --from=ocr-builder /opt/venvs/ocr/lib/python3.12/site-packages/nvidia /opt/venvs/ocr/lib/python3.12/site-packages/nvidia
COPY --from=triton-launcher-builder /opt/triton-cache /opt/triton-cache
COPY --from=python-builder /usr/local/lib/python3.10/dist-packages /usr/local/lib/python3.10/dist-packages
COPY --from=python-builder /opt/venvs/ram /opt/venvs/ram
COPY --from=python-builder /opt/venvs/dinov2 /opt/venvs/dinov2
COPY --from=python-builder /opt/venvs/insightface /opt/venvs/insightface
COPY --from=unlimited-ocr-model /opt/models/unlimited-ocr /opt/models/unlimited-ocr
COPY --from=dinov2-model /opt/models/dinov2-small /opt/models/dinov2-small
COPY --from=bert-tokenizer-model /opt/models/huggingface /opt/models/huggingface
COPY --from=ram-model /opt/models/ram /opt/models/ram
COPY --from=insightface-model /opt/models/insightface /opt/models/insightface
COPY --from=image-aesthetics-model /opt/models/clip /opt/models/clip
COPY --from=image-aesthetics-model /opt/models/aesthetic /opt/models/aesthetic

RUN set -eux; \
    ! command -v cc; \
    test -n "$(find /opt/triton-cache -name 'cuda_utils*.so' -print -quit)"; \
    export XDG_CACHE_HOME=/tmp/verification-cache; \
    /opt/venvs/ocr/bin/python -c "import sys, torch, vllm; from pathlib import Path; assert sys.version_info[:2] == (3, 12); assert torch.version.cuda == '12.9'; assert Path(sys._base_executable).is_relative_to('/opt/python'); assert (Path('/opt/models/unlimited-ocr') / 'config.json').is_file()"; \
    /opt/venvs/ram/bin/python -c "import ram, torch, transformers; from pathlib import Path; from transformers import BertTokenizer; assert torch.__file__.startswith('/usr/local/lib/python3.10/dist-packages/'); assert transformers.__version__ == '${TRANSFORMERS_RAM_VERSION}'; assert BertTokenizer.from_pretrained('bert-base-uncased', local_files_only=True).vocab_size == 30522; assert (Path('/opt/models/ram') / 'ram_plus_swin_large_14m.pth').is_file()"; \
    /opt/venvs/dinov2/bin/python -c "import clip, torch, transformers; from pathlib import Path; from transformers import AutoConfig; assert torch.__file__.startswith('/usr/local/lib/python3.10/dist-packages/'); assert transformers.__version__ == '${TRANSFORMERS_DINOV2_VERSION}'; assert AutoConfig.from_pretrained('/opt/models/dinov2-small', local_files_only=True).hidden_size == 384; assert 'ViT-B/32' in clip.available_models(); state = torch.load('/opt/models/aesthetic/sa_0_4_vit_b_32_linear.pth', map_location='cpu', weights_only=True); assert state['weight'].shape == (1, 512); assert state['bias'].shape == (1,); assert Path('/opt/models/clip/ViT-B-32.pt').is_file()"; \
    /opt/venvs/insightface/bin/python -c "import insightface, onnxruntime; from pathlib import Path; assert any((Path('/opt/models/insightface/models/buffalo_l')).glob('*.onnx'))"; \
    rm -rf /tmp/verification-cache

WORKDIR /app

COPY --from=rust-builder /app/build/target/release/llm-service /app/llm-service
COPY src/backend_llm/*.py /app/runtimes/
COPY docker/entrypoint_llm.sh /entrypoint_llm.sh

RUN chmod +x /entrypoint_llm.sh \
    && mkdir -p /data/llm/cache/triton /data/llm/queue /data/logs

EXPOSE 8100

ENTRYPOINT ["/usr/bin/tini", "--", "/entrypoint_llm.sh"]
CMD ["/app/llm-service", "-c", "/data/config_llm.toml"]
