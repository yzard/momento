FROM rust:1-alpine AS builder

WORKDIR /app

RUN apk add --no-cache musl-dev

COPY src/backend_llm ./src/backend_llm

RUN CARGO_TARGET_DIR=/app/build/target cargo build --release --manifest-path /app/src/backend_llm/Cargo.toml

FROM alpine:latest

RUN apk add --no-cache ca-certificates docker-cli su-exec tzdata wget

WORKDIR /app

COPY --from=builder /app/build/target/release/llm-service /app/llm-service
COPY src/backend_llm/*.py /app/src/backend_llm/
COPY docker/entrypoint_llm.sh /entrypoint_llm.sh

RUN chmod +x /entrypoint_llm.sh && mkdir -p /data

ENV RUST_BACKTRACE=full

EXPOSE 8100

ENTRYPOINT ["/entrypoint_llm.sh"]
CMD ["/app/llm-service", "-c", "/data/config_llm.toml"]
